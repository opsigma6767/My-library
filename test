    function Window:SelectTab(TabName)
        if not self.Tabs[TabName] then return end
        for _, tab in pairs(self.Tabs) do
            tab.Content.Visible = false
            TweenService:Create(tab.Button, TweenInfo.new(0.18), {BackgroundTransparency=1, TextColor3=Color3.fromRGB(125,125,130)}):Play()
            TweenService:Create(tab.ActiveBar, TweenInfo.new(0.18), {BackgroundTransparency=1}):Play()
        end
        local sel = self.Tabs[TabName]
        sel.Content.Visible = true
        TweenService:Create(sel.Button, TweenInfo.new(0.18), {BackgroundTransparency=0, TextColor3=Color3.fromRGB(20,20,20)}):Play()
        TweenService:Create(sel.ActiveBar, TweenInfo.new(0.18), {BackgroundTransparency=0}):Play()
        self.CurrentTab = sel
    end

    local function resolveColor(Color)
        if type(Color) == "table" then
            return Color3.fromRGB(
                math.clamp(Color[1] or 40, 0, 255),
                math.clamp(Color[2] or 120, 0, 255),
                math.clamp(Color[3] or 255, 0, 255)
            )
        end
        return Color3.fromRGB(40, 120, 255)
    end

    local function ensureTab(TabName)
        if not Window.Tabs[TabName] then
            CreateTabLogic(TabName, false)
            if not Window.CurrentTab then Window:SelectTab(TabName) end
        end
        return Window.Tabs[TabName]
    end


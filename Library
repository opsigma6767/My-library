        TabBtn.Parent = isBottomTab and BottomTabContainer or TabContainer
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 7)

        -- Left indicator bar for active tab
        local ActiveBar = Instance.new("Frame")
        ActiveBar.Size = UDim2.new(0, 3, 0, 16)
        ActiveBar.Position = UDim2.new(0, 5, 0.5, -8)
        ActiveBar.BackgroundColor3 = Color3.fromRGB(40, 120, 255)
        ActiveBar.BorderSizePixel = 0
        ActiveBar.BackgroundTransparency = 1
        ActiveBar.Parent = TabBtn
        Instance.new("UICorner", ActiveBar).CornerRadius = UDim.new(1, 0)

        -- Content scroll frame for this tab
        local TabContent = Instance.new("ScrollingFrame")
        TabContent.Size = UDim2.new(1, -18, 1, -18)
        TabContent.Position = UDim2.new(0, 9, 0, 9)
        TabContent.BackgroundTransparency = 1
        TabContent.ScrollBarThickness = 2
        TabContent.ScrollBarImageColor3 = Color3.fromRGB(200, 200, 205)
        TabContent.AutomaticCanvasSize = Enum.AutomaticSize.Y
        TabContent.CanvasSize = UDim2.new(0, 0, 0, 0)
        TabContent.Visible = false
        TabContent.Parent = ContentContainer

        local ContentLayout = Instance.new("UIListLayout")
        ContentLayout.SortOrder = Enum.SortOrder.LayoutOrder
        ContentLayout.Padding = UDim.new(0, 8)
        ContentLayout.Parent = TabContent

        local TabObj = {
            Button = TabBtn,
            ActiveBar = ActiveBar,
            Content = TabContent,
            Name = TabName,
            ButtonCount = 0,
            Sections = {} -- section name → last LayoutOrder used
        }
        Window.Tabs[TabName] = TabObj

        TabBtn.MouseEnter:Connect(function()
            if Window.CurrentTab ~= TabObj then
                TweenService:Create(TabBtn, TweenInfo.new(0.15), {
                    BackgroundTransparency = 0.6,
                    TextColor3 = Color3.fromRGB(60, 60, 65)
                }):Play()
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if Window.CurrentTab ~= TabObj then
                TweenService:Create(TabBtn, TweenInfo.new(0.15), {
                    BackgroundTransparency = 1,
                    TextColor3 = Color3.fromRGB(125, 125, 130)
                }):Play()
            end
        end)
        TabBtn.MouseButton1Click:Connect(function() Window:SelectTab(TabName) end)
        return TabObj
    end

    function Window:SelectTab(TabName)
        if not self.Tabs[TabName] then return end
        for _, tab in pairs(self.Tabs) do
            tab.Content.Visible = false
            TweenService:Create(tab.Button, TweenInfo.new(0.18), {
                BackgroundTransparency = 1,
                TextColor3 = Color3.fromRGB(125, 125, 130)
            }):Play()
            TweenService:Create(tab.ActiveBar, TweenInfo.new(0.18), {
                BackgroundTransparency = 1
            }):Play()
        end
        local sel = self.Tabs[TabName]
        sel.Content.Visible = true
        TweenService:Create(sel.Button, TweenInfo.new(0.18), {
            BackgroundTransparency = 0,
            TextColor3 = Color3.fromRGB(20, 20, 20)
        }):Play()
        TweenService:Create(sel.ActiveBar, TweenInfo.new(0.18), {
            BackgroundTransparency = 0
        }):Play()
        self.CurrentTab = sel
    end

    -- ==========================================
    -- AddSection
    -- Adds a bold section header inside a tab
    -- Usage: UI:AddSection("TabName", "Section Title")
    -- ==========================================
    function Window:AddSection(TabName, SectionTitle)
        -- Auto-create tab if it doesn't exist
        if not self.Tabs[TabName] then
            CreateTabLogic(TabName, false)
            if not self.CurrentTab then self:SelectTab(TabName) end
        end

        local tabObj = self.Tabs[TabName]
        tabObj.ButtonCount += 1

        -- Track this section's layout order start
        tabObj.Sections[SectionTitle] = tabObj.ButtonCount

        -- Container for section header row
        local SectionFrame = Instance.new("Frame")
        SectionFrame.Size = UDim2.new(1, 0, 0, 28)
        SectionFrame.BackgroundTransparency = 1
        SectionFrame.LayoutOrder = tabObj.ButtonCount
        SectionFrame.Parent = tabObj.Content

        -- Section label
        local SectionLabel = Instance.new("TextLabel")
        SectionLabel.Size = UDim2.new(1, -12, 1, 0)
        SectionLabel.Position = UDim2.new(0, 6, 0, 0)
        SectionLabel.BackgroundTransparency = 1
        SectionLabel.Text = SectionTitle
        SectionLabel.Font = Enum.Font.GothamBlack
        SectionLabel.TextSize = 11
        SectionLabel.TextColor3 = Color3.fromRGB(140, 140, 148)
        SectionLabel.TextXAlignment = Enum.TextXAlignment.Left
        SectionLabel.Parent = SectionFrame

        -- Horizontal rule line to the right of the label
        -- We create a thin line that fills the remainder of the row
        local LineContainer = Instance.new("Frame")
        LineContainer.Size = UDim2.new(1, -12, 0, 1)
        LineContainer.Position = UDim2.new(0, 6, 0.5, 8)
        LineContainer.BackgroundColor3 = Color3.fromRGB(225, 225, 230)
        LineContainer.BorderSizePixel = 0
        LineContainer.Parent = SectionFrame
    end

    -- ==========================================
    -- AddButton (NEW SIGNATURE)
    -- UI:AddButton(TabName, Section, ButtonName, Color, InfoText, Callback)
    --   TabName    : string  — which tab this goes in
    --   Section    : string or nil — section name (must match an AddSection call), or nil
    --   ButtonName : string  — label on the button
    --   Color      : table {R, G, B} — accent color for the left bar and info dot
    --   InfoText   : string  — shown in the info modal
    --   Callback   : function — called on click
    -- ==========================================
    function Window:AddButton(TabName, Section, ButtonName, Color, InfoText, Callback)
        if not self.Tabs[TabName] then
            CreateTabLogic(TabName, false)
            if not self.CurrentTab then self:SelectTab(TabName) end
        end

        local tabObj = self.Tabs[TabName]
        tabObj.ButtonCount += 1

        -- Resolve accent color
        local accentColor
        if type(Color) == "table" then
            accentColor = Color3.fromRGB(
                math.clamp(Color[1] or 40,  0, 255),
                math.clamp(Color[2] or 120, 0, 255),
                math.clamp(Color[3] or 255, 0, 255)
            )
        else
            accentColor = Color3.fromRGB(40, 120, 255) -- fallback
        end

        -- Outer frame
        local BtnFrame = Instance.new("Frame")
        BtnFrame.Size = UDim2.new(1, 0, 0, 44)
        BtnFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        BtnFrame.LayoutOrder = tabObj.ButtonCount
        BtnFrame.Parent = tabObj.Content
        Instance.new("UICorner", BtnFrame).CornerRadius = UDim.new(0, 8)

        local Stroke = Instance.new("UIStroke")
        Stroke.Color = Color3.fromRGB(224, 224, 229)
        Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        Stroke.Thickness = 1.2
        Stroke.Parent = BtnFrame

        -- Colored left accent bar
        local AccentBar = Instance.new("Frame")
        AccentBar.Size = UDim2.new(0, 4, 0, 26)
        AccentBar.Position = UDim2.new(0, 8, 0.5, -13)
        AccentBar.BackgroundColor3 = accentColor
        AccentBar.BorderSizePixel = 0
        AccentBar.Parent = BtnFrame
        Instance.new("UICorner", AccentBar).CornerRadius = UDim.new(1, 0)

        -- Subtle glow behind accent bar (same color, very transparent)
        local AccentGlow = Instance.new("Frame")
        AccentGlow.Size = UDim2.new(0, 18, 0, 36)
        AccentGlow.Position = UDim2.new(0, 2, 0.5, -18)
        AccentGlow.BackgroundColor3 = accentColor
        AccentGlow.BackgroundTransparency = 0.85
        AccentGlow.BorderSizePixel = 0
        AccentGlow.ZIndex = 0
        AccentGlow.Parent = BtnFrame
        Instance.new("UICorner", AccentGlow).CornerRadius = UDim.new(1, 0)

        -- Main clickable button (text)
        local MainBtn = Instance.new("TextButton")
        MainBtn.Size = UDim2.new(1, -50, 1, 0)
        MainBtn.Position = UDim2.new(0, 20, 0, 0)
        MainBtn.BackgroundTransparency = 1
        MainBtn.Text = ButtonName
        MainBtn.Font = Enum.Font.GothamSemibold
        MainBtn.TextSize = 13
        MainBtn.TextColor3 = Color3.fromRGB(35, 35, 35)
        MainBtn.TextXAlignment = Enum.TextXAlignment.Left
        MainBtn.Parent = BtnFrame

        -- Info dot (circle button, matches accent color)
        local InfoBtn = Instance.new("TextButton")
        InfoBtn.Size = UDim2.new(0, 28, 0, 28)
        InfoBtn.Position = UDim2.new(1, -36, 0.5, -14)
        InfoBtn.BackgroundColor3 = accentColor
        InfoBtn.BackgroundTransparency = 0.82
        InfoBtn.Text = "i"
        InfoBtn.Font = Enum.Font.GothamBlack
        InfoBtn.TextSize = 11
        InfoBtn.TextColor3 = accentColor
        InfoBtn.Parent = BtnFrame
        Instance.new("UICorner", InfoBtn).CornerRadius = UDim.new(1, 0)

        -- Hover effects
        BtnFrame.MouseEnter:Connect(function()
            TweenService:Create(BtnFrame, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(248, 248, 252)}):Play()
            TweenService:Create(Stroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(195, 195, 205)}):Play()
            TweenService:Create(InfoBtn, TweenInfo.new(0.15), {BackgroundTransparency = 0.65}):Play()
        end)
        BtnFrame.MouseLeave:Connect(function()
            TweenService:Create(BtnFrame, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            TweenService:Create(Stroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(224, 224, 229)}):Play()
            TweenService:Create(InfoBtn, TweenInfo.new(0.15), {BackgroundTransparency = 0.82}):Play()
        end)

        -- Click: brief accent flash on the bar
        MainBtn.MouseButton1Click:Connect(function()
            TweenService:Create(AccentBar, TweenInfo.new(0.08), {Size = UDim2.new(0, 4, 0, 34)}):Play()
            task.delay(0.08, function()
                TweenService:Create(AccentBar, TweenInfo.new(0.12), {Size = UDim2.new(0, 4, 0, 26)}):Play()
            end)
            pcall(Callback)
        end)

        -- Info button shows modal with matching accent color
        InfoBtn.MouseButton1Click:Connect(function()
            self:ShowInfo(InfoText or "Tidak ada deskripsi.", accentColor)
        end)
    end

    -- ==========================================
    -- TAB GENERATOR (built-in utility tab)
    -- ==========================================
    CreateTabLogic("Generator", true)
    local GenTab = Window.Tabs["Generator"].Content

    local function CreateInput(parent, placeholder, layoutOrder)
        local box = Instance.new("TextBox")
        box.Size = UDim2.new(1, 0, 0, 36)
        box.BackgroundColor3 = Color3.fromRGB(245, 245, 250)
        box.PlaceholderText = placeholder
        box.Text = ""
        box.Font = Enum.Font.GothamMedium
        box.TextSize = 12
        box.TextColor3 = Color3.fromRGB(20, 20, 20)
        box.LayoutOrder = layoutOrder or 0
        box.Parent = parent
        Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
        local s = Instance.new("UIStroke", box)
        s.Color = Color3.fromRGB(218, 218, 223)
        box.Focused:Connect(function() Window.IsBinding = false end)
        return box
    end

    local InpTab     = CreateInput(GenTab, "Tab name  (e.g. Main)",       1)
    local InpSection = CreateInput(GenTab, "Section   (e.g. Farming) — optional", 2)
    local InpName    = CreateInput(GenTab, "Button name  (e.g. Auto Farm)",  3)
    local InpInfo    = CreateInput(GenTab, "Info text",                    4)
    local InpColorR  = CreateInput(GenTab, "R  (0-255)",                   5)
    local InpColorG  = CreateInput(GenTab, "G  (0-255)",                   6)
    local InpColorB  = CreateInput(GenTab, "B  (0-255)",                   7)

    local GenBtnFrame = Instance.new("Frame")
    GenBtnFrame.Size = UDim2.new(1, 0, 0, 40)
    GenBtnFrame.BackgroundColor3 = Color3.fromRGB(40, 120, 255)
    GenBtnFrame.LayoutOrder = 8
    GenBtnFrame.Parent = GenTab
    Instance.new("UICorner", GenBtnFrame).CornerRadius = UDim.new(0, 8)

    local GenBtn = Instance.new("TextButton")
    GenBtn.Size = UDim2.new(1, 0, 1, 0)
    GenBtn.BackgroundTransparency = 1
    GenBtn.Text = "Generate & Copy Code"
    GenBtn.Font = Enum.Font.GothamBold
    GenBtn.TextSize = 13
    GenBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    GenBtn.Parent = GenBtnFrame

    GenBtn.MouseButton1Click:Connect(function()
        GenBtn.Interactable = false

        local t = InpTab.Text     ~= "" and InpTab.Text     or "Main"
        local sc = InpSection.Text ~= "" and ('"' .. InpSection.Text .. '"') or "nil"
        local n = InpName.Text    ~= "" and InpName.Text    or "New Button"
        local i = InpInfo.Text    ~= "" and InpInfo.Text    or "No description."
        local r = tonumber(InpColorR.Text) or 40
        local g = tonumber(InpColorG.Text) or 120
        local b = tonumber(InpColorB.Text) or 255

        -- Also generate AddSection call if a section was provided
        local sectionLine = ""
        if sc ~= "nil" then
            sectionLine = string.format('UI:AddSection("%s", %s)\n', t, sc)
        end

        local code = sectionLine .. string.format(
            'UI:AddButton("%s", %s, "%s", {%d, %d, %d}, "%s", function()\n    print("%s clicked!")\nend)',
            t, sc, n, r, g, b, i, n
        )

        copyToClipboard(code)
        GenBtn.Text = "Copied!"
        task.delay(1.5, function()
            GenBtn.Text = "Generate & Copy Code"
            GenBtn.Interactable = true
        end)
    end)

    -- ==========================================
    -- SETTINGS TAB
    -- ==========================================
    CreateTabLogic("Settings", true)
    local SettingsTab = Window.Tabs["Settings"].Content

    local function SLabel(txt, order)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 0, 26)
        lbl.BackgroundTransparency = 1
        lbl.Text = txt
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 13
        lbl.TextColor3 = Color3.fromRGB(38, 38, 38)
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.LayoutOrder = order
        lbl.Parent = SettingsTab
        return lbl
    end

    SLabel("Toggle Hotkey (PC)", 1)

    KeybindBtn_ref = Instance.new("TextButton")
    KeybindBtn_ref.Size = UDim2.new(1, 0, 0, 38)
    KeybindBtn_ref.BackgroundColor3 = Color3.fromRGB(240, 240, 245)
    KeybindBtn_ref.Text = "Key: " .. Window.ToggleKey.Name
    KeybindBtn_ref.Font = Enum.Font.GothamBold
    KeybindBtn_ref.TextSize = 13
    KeybindBtn_ref.TextColor3 = Color3.fromRGB(40, 120, 255)
    KeybindBtn_ref.LayoutOrder = 2
    KeybindBtn_ref.Parent = SettingsTab
    Instance.new("UICorner", KeybindBtn_ref).CornerRadius = UDim.new(0, 7)
    Instance.new("UIStroke", KeybindBtn_ref).Color = Color3.fromRGB(218, 218, 223)

    KeybindBtn_ref.MouseButton1Click:Connect(function()
        if not Window.IsMobile then
            Window.IsBinding = true
            KeybindBtn_ref.Text = "Press any key..."
        end
    end)

    SLabel("UI Scale", 3)

    local ScaleRow = Instance.new("Frame")
    ScaleRow.Size = UDim2.new(1, 0, 0, 38)
    ScaleRow.BackgroundTransparency = 1
    ScaleRow.LayoutOrder = 4
    ScaleRow.Parent = SettingsTab

    local function ScaleBtn(txt, xpos)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, 38, 0, 38)
        b.Position = UDim2.new(0, xpos, 0, 0)
        b.BackgroundColor3 = Color3.fromRGB(240, 240, 245)
        b.Text = txt
        b.Font = Enum.Font.GothamBlack
        b.TextSize = 20
        b.TextColor3 = Color3.fromRGB(55, 55, 55)
        b.Parent = ScaleRow
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
        return b
    end

    local BtnMinus = ScaleBtn("-", 0)
    local BtnPlus  = ScaleBtn("+", 154)

    local ScaleDisplay = Instance.new("TextLabel")
    ScaleDisplay.Size = UDim2.new(0, 108, 0, 38)
    ScaleDisplay.Position = UDim2.new(0, 44, 0, 0)
    ScaleDisplay.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    ScaleDisplay.Text = tostring(math.round(UIScale.Scale * 100)) .. "%"
    ScaleDisplay.Font = Enum.Font.GothamBold
    ScaleDisplay.TextSize = 13
    ScaleDisplay.TextColor3 = Color3.fromRGB(35, 35, 35)
    ScaleDisplay.Parent = ScaleRow
    Instance.new("UICorner", ScaleDisplay).CornerRadius = UDim.new(0, 7)
    Instance.new("UIStroke", ScaleDisplay).Color = Color3.fromRGB(218, 218, 223)

    local function updateScale(delta)
        local s = math.clamp(math.round((UIScale.Scale + delta) * 10) / 10, 0.5, 2.0)
        UIScale.Scale = s
        ScaleDisplay.Text = tostring(math.round(s * 100)) .. "%"
    end
    BtnMinus.MouseButton1Click:Connect(function() updateScale(-0.1) end)
    BtnPlus.MouseButton1Click:Connect(function()  updateScale( 0.1) end)

    -- Mobile adjustments
    if Window.IsMobile then
        KeybindBtn_ref.Text = "Not available on mobile"
        KeybindBtn_ref.Active = false
        KeybindBtn_ref.BackgroundColor3 = Color3.fromRGB(228, 228, 228)
        KeybindBtn_ref.TextColor3 = Color3.fromRGB(155, 155, 155)
    end

    if not Window.CurrentTab then Window:SelectTab("Generator") end
    return Window
end

return UILibrary

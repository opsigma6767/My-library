        [Enum.KeyCode.Return]    = true,
        [Enum.KeyCode.Space]     = true,
        [Enum.KeyCode.Backspace] = true,
        [Enum.KeyCode.Unknown]   = true,
    }

    local KeybindBtn_ref -- forward reference, assigned in Settings tab

    table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
        -- Priority: capture keybind
        if Window.IsBinding and input.UserInputType == Enum.UserInputType.Keyboard then
            if not BLOCKED_KEYS[input.KeyCode] then
                Window.ToggleKey = input.KeyCode
            end
            if KeybindBtn_ref then
                KeybindBtn_ref.Text = "Tombol: " .. Window.ToggleKey.Name
            end
            Window.IsBinding = false
            return
        end

        -- Normal toggle
        if processed then return end
        if input.KeyCode == Window.ToggleKey then
            if MainFrame.Visible then
                TweenService:Create(MainFrame, TweenInfo.new(0.2), {Size = mainClosedSize}):Play()
                task.delay(0.22, function() MainFrame.Visible = false end)
            else
                MainFrame.Visible = true
                TweenService:Create(MainFrame, TweenInfo.new(0.2), {Size = mainOpenSize}):Play()
                FloatingBtn.Visible = false
            end
        end
    end))


        or input.UserInputType == Enum.UserInputType.Touch then
            f_dragInput = input
        end
    end)

    table.insert(connections, UserInputService.InputChanged:Connect(function(input)
        if input == m_dragInput and m_dragging then
            local d = input.Position - m_dragStart
            MainFrame.Position = UDim2.new(
                m_startPos.X.Scale, m_startPos.X.Offset + d.X,
                m_startPos.Y.Scale, m_startPos.Y.Offset + d.Y
            )
        elseif input == f_dragInput and f_dragging then
            local d = input.Position - f_dragStart
            if d.Magnitude > 5 then f_dragMoved = true end
            FloatingBtn.Position = UDim2.new(
                f_startPos.X.Scale, f_startPos.X.Offset + d.X,
                f_startPos.Y.Scale, f_startPos.Y.Offset + d.Y
            )
        end
    end))


--[[
    UI Library "White Classic v9 - Public Release Edition"
    
    NEW FEATURES:
    - AddSection(TabName, SectionTitle)
        → Adds a full-width section divider/header label inside a tab
    
    - AddButton(TabName, SectionOrNil, ButtonName, Color, InfoText, Callback)
        → Color is a table: {R, G, B}  e.g. {40, 120, 255}
        → SectionOrNil: pass a section name string to group under it, or nil for no group
        → The left edge of the button glows with the chosen color
        → Info dot also uses the button color
    
    USAGE EXAMPLE:
        local UI = UILibrary:CreateWindow("My Hub")

        UI:AddSection("Main", "Farming Tools")
        UI:AddButton("Main", "Farming Tools", "Auto Farm", {40, 200, 100}, "Starts auto farm.", function()
            print("Auto Farm ON")
        end)

        UI:AddSection("Main", "Movement")
        UI:AddButton("Main", "Movement", "Speed Hack", {255, 150, 40}, "Makes you run faster.", function()
            game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 50
        end)

        -- Button without a section:
        UI:AddButton("Settings", nil, "Reset Stats", {200, 60, 60}, "Resets all stats.", function()
            print("Reset!")
        end)

    HOST ON GITHUB:
        Paste this file into your repo as library.lua
        The last line must be: return UILibrary
        Users load it with:
            local UILibrary = loadstring(game:HttpGet("YOUR_RAW_URL"))()
]]

local TweenService = game:GetService("TweenService")

-- =============================================================================
-- SYSTEM DECORATOR MODULES FOR BOX ADORNMENT CHAMS
-- =============================================================================
local function updateAdornmentChams(p, char)
    local cache = espCache[p.UserId]
    if not cache then return end

    if not cache.ChamsAdornments then cache.ChamsAdornments = {} end

    local vActive = state.Chams.VisibleEnabled
    local hActive = state.Chams.HiddenEnabled

    if not vActive and not hActive then
        for _, adorns in pairs(cache.ChamsAdornments) do
            if adorns.Visible then adorns.Visible.Visible = false end
            if adorns.Hidden then adorns.Hidden.Visible = false end
        end
        return
    end

    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            local adorns = cache.ChamsAdornments[part]
            if not adorns then
                adorns = {}
                cache.ChamsAdornments[part] = adorns
            end

            if vActive then
                local vAdorn = adorns.Visible
                if not vAdorn or vAdorn.Parent == nil then
                    vAdorn = Instance.new("BoxHandleAdornment")
                    vAdorn.Parent = ScreenGui
                    adorns.Visible = vAdorn
                end
                vAdorn.Adornee = part
                vAdorn.Size = part.Size + Vector3.new(0.04, 0.04, 0.04)
                vAdorn.Color3 = state.Chams.VisibleColor
                vAdorn.Transparency = state.Chams.VisibleTransparency
                vAdorn.AlwaysOnTop = false
                vAdorn.Visible = true
            elseif adorns.Visible then
                adorns.Visible.Visible = false
            end

            if hActive then
                local hAdorn = adorns.Hidden
                if not hAdorn or hAdorn.Parent == nil then
                    hAdorn = Instance.new("BoxHandleAdornment")
                    hAdorn.Parent = ScreenGui
                    adorns.Hidden = hAdorn
                end
                hAdorn.Adornee = part
                hAdorn.Size = part.Size + Vector3.new(0.02, 0.02, 0.02)
                hAdorn.Color3 = state.Chams.HiddenColor
                hAdorn.Transparency = state.Chams.HiddenTransparency
                hAdorn.AlwaysOnTop = true
                hAdorn.Visible = true
            elseif adorns.Hidden then
                adorns.Hidden.Visible = false
            end
        end
    end
end

-- =============================================================================
-- CORE PIPELINE LOOP PROCESSING RENDER CONTROLS
-- =============================================================================
local function checkTargetValidity(p)
    if not p or p == LocalPlayer then return false end
    local hasSelection = false
    for _, val in pairs(state.Players.Selected) do if val == true then hasSelection = true; break end end
    if hasSelection and not state.Players.Selected[p.UserId] then return false end
    if not p.Character or p.Character.Parent == nil then return false end
    return true
end

local function runRenderingIteration()
    local localHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localHrp then return end

    local camCFrame = Camera.CFrame
    local camLook = camCFrame.LookVector
    local camAngle = math.atan2(camLook.Z, camLook.X)
    local now = os.clock()

    if state.Radar.Enabled then
        updateRadarLayout()
        NorthText.Visible = state.Radar.NorthIndicator
        local radRadius = state.Radar.Size / 2
        NorthText.Position = UDim2.new(0.5, -6, 0, 4)

        for _, blip in pairs(radarBlips) do blip.Visible = false end

        for _, p in ipairs(Players:GetPlayers()) do
            if not checkTargetValidity(p) then continue end
            local thp = p.Character:FindFirstChild("HumanoidRootPart")
            if not thp then continue end

            local delta = thp.Position - localHrp.Position
            local dist = Vector2.new(delta.X, delta.Z).Magnitude
            if dist > (state.Settings.MaxDistance) then continue end

            local blip = radarBlips[p.UserId]
            if not blip then
                blip = Instance.new("Frame")
                blip.BorderSizePixel = 0
                local bc = Instance.new("UICorner")
                bc.CornerRadius = UDim.new(0, 4)
                bc.Parent = blip
                blip.Parent = RadarFrame
                radarBlips[p.UserId] = blip
            end

            blip.Size = UDim2.new(0, state.Radar.DotSize, 0, state.Radar.DotSize)
            blip.BackgroundColor3 = (p.Team == LocalPlayer.Team) and state.Radar.TeamColor or state.Radar.EnemyColor

            local relX = delta.X * math.cos(camAngle) + delta.Z * math.sin(camAngle)
            local relY = delta.Z * math.cos(camAngle) - delta.X * math.sin(camAngle)

            local scaledX = relX / state.Radar.Scale
            local scaledY = relY / state.Radar.Scale

            local cDist = math.sqrt(scaledX^2 + scaledY^2)
            if cDist > radRadius - 6 then
                scaledX = (scaledX / cDist) * (radRadius - 6)
                scaledY = (scaledY / cDist) * (radRadius - 6)
            end

            blip.Position = UDim2.new(0.5, scaledX - (state.Radar.DotSize / 2), 0.5, scaledY - (state.Radar.DotSize / 2))
            blip.Visible = true
        end
    else
        RadarFrame.Visible = false
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local valid = checkTargetValidity(p)
        local cache = espCache[p.UserId]
        local char = p.Character

        if not valid or not char then
            if cache then
                if hasDrawingAPI then
                    for _, obj in pairs(cache.Drawing) do if obj then obj.Visible = false end end
                end
                if cache.Highlight then cache.Highlight.Enabled = false end
                pcall(updateAdornmentChams, p, char)
            end
            continue
        end

        if cache and cache.CurrentCharacter ~= char then
            if hasDrawingAPI then
                for _, obj in pairs(cache.Drawing) do if obj then obj.Visible = false end end
            end
            if cache.Highlight then pcall(function() cache.Highlight:Destroy() end) end
            cache = nil
        end

        if not cache then
            cache = initializePlayerDrawingObjects(p)
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then
            if cache and hasDrawingAPI then for _, obj in pairs(cache.Drawing) do if obj then obj.Visible = false end end end
            continue
        end

        local distance = (hrp.Position - localHrp.Position).Magnitude
        if distance > state.Settings.MaxDistance then
            if cache and hasDrawingAPI then for _, obj in pairs(cache.Drawing) do if obj then obj.Visible = false end end end
            continue
        end

        local currentOpacity = 1 - state.ESP.Transparency
        if state.Settings.FadeWithDistance then
            local factor = 1 - (distance / state.Settings.MaxDistance)
            currentOpacity = currentOpacity * math.clamp(factor, 0.1, 1)
        end

        pcall(updateAdornmentChams, p, char)

        local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        local d = cache.Drawing

        if onScreen and hasDrawingAPI and d.MainBox then
            local head = char:FindFirstChild("Head")
            if head and state.ESP.Box then
                local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                local boxHeight = math.abs(headPos.Y - legPos.Y)
                local boxWidth = boxHeight * 0.6
                local boxX = screenPos.X - (boxWidth / 2)
                local boxY = headPos.Y

                if state.ESP.Style == "2D Box" then
                    d.MainBox.Size = Vector2.new(boxWidth, boxHeight)
                    d.MainBox.Position = Vector2.new(boxX, boxY)
                    d.MainBox.Color = state.ESP.Color
                    d.MainBox.Thickness = state.ESP.Thickness
                    d.MainBox.Transparency = currentOpacity
                    d.MainBox.Visible = true

                    if d.C1 then d.C1.Visible = false; d.C2.Visible = false; d.C3.Visible = false; d.C4.Visible = false end
                else
                    d.MainBox.Visible = false
                    local cLength = boxWidth * 0.25
                    
                    if d.C1 then
                        d.C1.From = Vector2.new(boxX, boxY); d.C1.To = Vector2.new(boxX + cLength, boxY); d.C1.Color = state.ESP.Color; d.C1.Thickness = state.ESP.Thickness; d.C1.Transparency = currentOpacity; d.C1.Visible = true
                        d.C2.From = Vector2.new(boxX, boxY); d.C2.To = Vector2.new(boxX, boxY + cLength); d.C2.Color = state.ESP.Color; d.C2.Thickness = state.ESP.Thickness; d.C2.Transparency = currentOpacity; d.C2.Visible = true
                        d.C3.From = Vector2.new(boxX + boxWidth, boxY); d.C3.To = Vector2.new(boxX + boxWidth - cLength, boxY); d.C3.Color = state.ESP.Color; d.C3.Thickness = state.ESP.Thickness; d.C3.Transparency = currentOpacity; d.C3.Visible = true
                        d.C4.From = Vector2.new(boxX + boxWidth, boxY); d.C4.To = Vector2.new(boxX + boxWidth, boxY + cLength); d.C4.Color = state.ESP.Color; d.C4.Thickness = state.ESP.Thickness; d.C4.Transparency = currentOpacity; d.C4.Visible = true
                    end
                end

                if state.ESP.HealthBar then
                    local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    d.HealthBar.From = Vector2.new(boxX - 6, boxY + boxHeight)
                    d.HealthBar.To = Vector2.new(boxX - 6, boxY + boxHeight - (boxHeight * pct))
                    d.HealthBar.Color = state.ESP.BarColorLow:Lerp(state.ESP.BarColorFull, pct)
                    d.HealthBar.Thickness = state.ESP.BarWidth
                    d.HealthBar.Transparency = currentOpacity
                    d.HealthBar.Visible = true
                else d.HealthBar.Visible = false end
            else
                d.MainBox.Visible = false
                d.HealthBar.Visible = false
                if d.C1 then d.C1.Visible = false; d.C2.Visible = false; d.C3.Visible = false; d.C4.Visible = false end
            end

            if state.ESP.Names and head then
                local displayText = p.DisplayName
                if state.ESP.ShowDistance then displayText = displayText .. string.format(" [%d]", math.round(distance)) end
                if state.ESP.ShowHealth then displayText = displayText .. string.format(" [%d%%]", math.round((hum.Health / hum.MaxHealth) * 100)) end

                d.TextLabel.Text = displayText
                d.TextLabel.Size = state.ESP.NameSize
                d.TextLabel.Center = true
                d.TextLabel.Outline = true
                d.TextLabel.Color = state.ESP.NameColor
                d.TextLabel.Transparency = currentOpacity
                d.TextLabel.Position = Vector2.new(screenPos.X, Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.2, 0)).Y)
                d.TextLabel.Visible = true
            else d.TextLabel.Visible = false end

            if state.ESP.HeadDot and head then
                local headScreen = Camera:WorldToViewportPoint(head.Position)
                d.HeadDotObj.Position = Vector2.new(headScreen.X, headScreen.Y)
                d.HeadDotObj.Radius = state.ESP.HeadDotSize
                d.HeadDotObj.Color = state.ESP.HeadDotColor
                d.HeadDotObj.Filled = true
                d.HeadDotObj.Transparency = currentOpacity
                d.HeadDotObj.Visible = true
            else d.HeadDotObj.Visible = false end

            if state.ESP.Skeleton then
                local bones = {
                    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
                    {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"},
                    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"},
                    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"},
                    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}
                }
                for idx, pair in ipairs(bones) do
                    local p1, p2 = char:FindFirstChild(pair[1]), char:FindFirstChild(pair[2])
                    local bLine = d["Bone_" .. idx]
                    if p1 and p2 and bLine then
                        local wp1, o1 = Camera:WorldToViewportPoint(p1.Position)
                        local wp2, o2 = Camera:WorldToViewportPoint(p2.Position)
                        if o1 and o2 then
                            bLine.From = Vector2.new(wp1.X, wp1.Y)
                            bLine.To = Vector2.new(wp2.X, wp2.Y)
                            bLine.Color = state.ESP.SkeletonColor
                            bLine.Thickness = state.ESP.SkeletonThickness
                            bLine.Transparency = (1 - state.ESP.SkeletonTransparency) * currentOpacity
                            bLine.Visible = true
                            continue
                        end
                    end
                    if bLine then bLine.Visible = false end
                end
            else
                for idx = 1, 10 do if d["Bone_" .. idx] then d["Bone_" .. idx].Visible = false end end
            end

            if state.ESP.LookDirection and head then
                local startWp = head.Position
                local endWp = startWp + (head.CFrame.LookVector * state.ESP.ArrowLength)
                local s2, o1 = Camera:WorldToViewportPoint(startWp)
                local e2, o2 = Camera:WorldToViewportPoint(endWp)

                if o1 and o2 then
                    d.LookArrow.From = Vector2.new(s2.X, s2.Y)
                    d.LookArrow.To = Vector2.new(e2.X, e2.Y)
                    d.LookArrow.Color = state.ESP.ArrowColor
                    d.LookArrow.Thickness = 2
                    d.LookArrow.Transparency = currentOpacity
                    d.LookArrow.Visible = true
                else d.LookArrow.Visible = false end
            else d.LookArrow.Visible = false end

            if state.Tracers.Enabled then
                local originPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                if state.Tracers.Origin == "Center of Screen" then originPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                elseif state.Tracers.Origin == "Mouse Position" then originPos = UserInputService:GetMouseLocation() end

                local tColor = state.Tracers.Color
                if state.Tracers.Rainbow then tColor = Color3.fromHSV((now * state.Tracers.RainbowSpeed * 0.1) % 1, 0.85, 1) end

                d.TracerLine.From = originPos
                d.TracerLine.To = Vector2.new(screenPos.X, screenPos.Y)
                d.TracerLine.Color = tColor
                d.TracerLine.Thickness = state.Tracers.Thickness
                d.TracerLine.Transparency = 1 - state.Tracers.Transparency
                d.TracerLine.Visible = true
            else d.TracerLine.Visible = false end
        else
            if hasDrawingAPI and d then
                for _, obj in pairs(d) do if obj then obj.Visible = false end end
            end
        end

        if state.Highlights.Enabled then
            local hl = cache.Highlight
            if not hl or hl.Parent ~= char then
                if hl then pcall(function() hl:Destroy() end) end
                hl = Instance.new("Highlight")
                hl.Parent = char
                cache.Highlight = hl
            end
            hl.Enabled = true
            hl.FillColor = state.Highlights.TeamColor and (p.TeamColor and p.TeamColor.Color or state.Highlights.FillColor) or state.Highlights.FillColor
            hl.FillTransparency = state.Highlights.FillTransparency
            hl.OutlineColor = state.Highlights.OutlineColor
            hl.OutlineTransparency = state.Highlights.OutlineTransparency
            hl.DepthMode = Enum.HighlightDepthMode[state.Highlights.DepthMode]
        elseif cache.Highlight then
            cache.Highlight.Enabled = false
        end
    end
end

connections[#connections+1] = RunService.RenderStepped:Connect(function() pcall(runRenderingIteration) end)

-- =============================================================================
-- INTERACTION KINEMATICS AUTOMATION PROCESSING MODULE (SPIN BOT)
-- =============================================================================
local function runPhysicsKinematicsCycle()
    if not state.SpinBot.Enabled then return end
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local pivotPosition = Vector3.new(0, 0, 0)
    local foundPivot = false

    if state.SpinBot.TargetMode == "Self" then
        pivotPosition = hrp.Position
        foundPivot = true
    else
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and state.Players.Selected[p.UserId] then
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then pivotPosition = p.Character.HumanoidRootPart.Position; foundPivot = true; break end
            end
        end
    end

    if not foundPivot then return end

    local t = os.clock() * state.SpinBot.OrbitSpeed * math.pi * 2
    local rad = state.SpinBot.OrbitDistance
    local hOff = state.SpinBot.HeightOffset

    local offsetX, offsetZ, offsetY = math.cos(t) * rad, math.sin(t) * rad, hOff

    if state.SpinBot.Axis == "Vertical" then offsetY, offsetZ = math.sin(t) * rad, hOff
    elseif state.SpinBot.Axis == "Figure-8" then offsetX, offsetZ = math.sin(t) * rad, math.sin(2 * t) * (rad / 2)
    end

    local targetCFrame = CFrame.new(pivotPosition + Vector3.new(offsetX, offsetY, offsetZ), pivotPosition)
    if state.SpinBot.Smooth then hrp.CFrame = hrp.CFrame:Lerp(targetCFrame, 0.22) else hrp.CFrame = targetCFrame end
end

connections[#connections+1] = RunService.Heartbeat:Connect(function() pcall(runPhysicsKinematicsCycle) end)


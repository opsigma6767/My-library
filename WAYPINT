local function addSelectorRow(tabName, labelText, options, stateTable, key, callback)
    local row, accent = createRowBase(tabName, labelText)
    row.Size = UDim2.new(1, -24, 0, 48)

    local container = Instance.new("Frame")
    container.Size = UDim2.new(0, 220, 0, 26)
    container.Position = UDim2.new(1, -230, 0.5, -13)
    container.BackgroundColor3 = Color3.fromRGB(240, 240, 245)
    container.Parent = row

    local cc = Instance.new("UICorner")
    cc.CornerRadius = UDim.new(0, 6)
    cc.Parent = container

    local segmentCount = #options
    local buttons = {}

    local function updateUI(currentVal)
        for idx, opt in ipairs(options) do
            local active = (opt == currentVal)
            local btn = buttons[idx]
            if btn then
                applyTween(btn, {0.15}, {
                    BackgroundColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(240, 240, 245),
                    TextColor3 = active and Color3.fromRGB(40, 120, 255) or Color3.fromRGB(120, 120, 130)
                })
            end
        end
        applyTween(accent, {0.15}, {BackgroundColor3 = Color3.fromRGB(40, 120, 255)})
    end

    for idx, opt in ipairs(options) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1 / segmentCount, -2, 1, -4)
        btn.Position = UDim2.new((idx - 1) / segmentCount, 1, 0, 2)
        btn.BackgroundColor3 = Color3.fromRGB(240, 240, 245)
        btn.Text = opt
        btn.Font = Enum.Font.SourceSansBold
        btn.TextSize = 12
        btn.TextColor3 = Color3.fromRGB(120, 120, 130)
        btn.Parent = container

        local bc = Instance.new("UICorner")
        bc.CornerRadius = UDim.new(0, 4)
        bc.Parent = btn

        btn.MouseButton1Click:Connect(function()
            stateTable[key] = opt
            updateUI(opt)
            if callback then callback(opt) end
        end)

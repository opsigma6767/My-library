local hasDrawingAPI = pcall(function()
    local test = Drawing.new("Line")
    test.Visible = false
    test:Remove()
    return true
end)

local function DrawingNew(className)
    if hasDrawingAPI then
        local success, obj = pcall(function() return Drawing.new(className) end)
        if success then return obj end
    end
    return nil
end

-- =============================================================================
-- RESOURCE LIFECYCLE MANAGEMENT CACHES
-- =============================================================================
local connections = {}
local espCache = {}
local activeUIRows = {}
local isBinding = false

local function cleanDrawingObject(obj)
    if not obj then return end
    pcall(function() obj.Visible = false obj:Remove() end)
end

local function cleanPlayerCache(userId)
    local data = espCache[userId]
    if not data then return end
    
    if data.Drawing then
        for _, obj in pairs(data.Drawing) do cleanDrawingObject(obj) end
    end
    if data.Highlight then 
        pcall(function() data.Highlight:Destroy() end) 
    end
    if data.ChamsAdornments then
        for _, adorns in pairs(data.ChamsAdornments) do
            if adorns.Visible then pcall(function() adorns.Visible:Destroy() end) end
            if adorns.Hidden then pcall(function() adorns.Hidden:Destroy() end) end
        end
    end
    espCache[userId] = nil
end

local function initializePlayerDrawingObjects(p)
    local uid = p.UserId
    if espCache[uid] and espCache[uid].Drawing then return espCache[uid] end

    local d = {}
    if hasDrawingAPI then
        d.MainBox = DrawingNew("Square")
        d.HealthBar = DrawingNew("Line")
        d.TextLabel = DrawingNew("Text")
        d.HeadDotObj = DrawingNew("Circle")
        d.LookArrow = DrawingNew("Line")
        d.TracerLine = DrawingNew("Line")
        
        for idx = 1, 10 do
            d["Bone_" .. tostring(idx)] = DrawingNew("Line")
        end
        
        -- Pre-create corner box slots
        d.C1 = DrawingNew("Line")
        d.C2 = DrawingNew("Line")
        d.C3 = DrawingNew("Line")
        d.C4 = DrawingNew("Line")
        
        for _, obj in pairs(d) do
            if obj then obj.Visible = false end
        end
    end

    local cacheEntry = { Drawing = d, ChamsAdornments = {}, CurrentCharacter = p.Character }
    espCache[uid] = cacheEntry
    return cacheEntry
end


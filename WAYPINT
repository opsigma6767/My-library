        btn.TextColor3 = Color3.fromRGB(220, 60, 60)
        local conn
        conn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                local b = input.KeyCode
                if b ~= Enum.KeyCode.Escape and b ~= Enum.KeyCode.Return and b ~= Enum.KeyCode.Space and b ~= Enum.KeyCode.Backspace and b ~= Enum.KeyCode.Unknown then
                    stateTable[key] = b
                    btn.Text = b.Name
                    btn.TextColor3 = Color3.fromRGB(80, 80, 85)
                    conn:Disconnect()
                    isBinding = false
                end
            end
        end)
    end)

    registerRowSync(stateTable, key, updateUI)

local function applyTween(obj, info, targets)
    local tween = TweenService:Create(obj, TweenInfo.new(unpack(info)), targets)
    tween:Play()
    return tween
end

local function initDrag(dragFrame, targetFrame)
    local dragging, dragInput, dragStart, startPos
    connections[#connections+1] = dragFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    connections[#connections+1] = dragFrame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    connections[#connections+1] = UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            targetFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end
initDrag(TopBar, MainFrame)
initDrag(MobileButton, MobileButton)


local function toggleMenu(forcedState)
    local target = (forcedState ~= nil) and forcedState or (not MainFrame.Visible)
    if target then
        MainFrame.Visible = true
        applyTween(MainFrame, {0.2}, {Size = UDim2.new(0, 560, 0, 400)})
        if UserInputService.TouchEnabled then MobileButton.Visible = false end
    else
        applyTween(MainFrame, {0.15}, {Size = UDim2.new(0, 560, 0, 0)}).Completed:Connect(function()
            if MainFrame.Size.Y.Offset == 0 then
                MainFrame.Visible = false
                if UserInputService.TouchEnabled then MobileButton.Visible = true end
            end
        end)
    end
end

local function initSidebarNavigation()
    local order = {"ESP", "Chams", "Tracers", "Highlights", "Radar", "Spin Bot", "Players", "Settings"}
    for idx, name in ipairs(order) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -12, 0, 34)
        btn.BackgroundTransparency = 1
        btn.Text = name
        btn.Font = Enum.Font.SourceSansSemibold
        btn.TextSize = 13
        btn.TextColor3 = Color3.fromRGB(100, 100, 105)
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.LayoutOrder = idx

        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0, 14)
        pad.Parent = btn

        local bc = Instance.new("UICorner")
        bc.CornerRadius = UDim.new(0, 6)
        bc.Parent = btn

        local indicator = Instance.new("Frame")
        indicator.Size = UDim2.new(0, 3, 0, 14)
        indicator.Position = UDim2.new(0, -10, 0.5, -7)
        indicator.BackgroundColor3 = Color3.fromRGB(40, 120, 255)
        indicator.BorderSizePixel = 0
        indicator.Visible = false
        indicator.Parent = btn

        if name == "Players" or name == "Settings" then btn.Parent = SidebarFixed else btn.Parent = SidebarScroll end

        local function switch()
            state.UI.CurrentTab = name
            for k, tabFrame in pairs(tabs) do tabFrame.Visible = (k == name) end
            for _, oBtn in pairs(SidebarScroll:GetChildren()) do
                if oBtn:IsA("TextButton") then
                    applyTween(oBtn, {0.15}, {BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(100, 100, 105)})
                    if oBtn:FindFirstChild("Frame") then oBtn.Frame.Visible = false end
                end
            end
            for _, oBtn in pairs(SidebarFixed:GetChildren()) do
                if oBtn:IsA("TextButton") then
                    applyTween(oBtn, {0.15}, {BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(100, 100, 105)})
                    if oBtn:FindFirstChild("Frame") then oBtn.Frame.Visible = false end
                end
            end
            applyTween(btn, {0.15}, {BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(255, 255, 255), TextColor3 = Color3.fromRGB(40, 120, 255)})
            indicator.Visible = true
        end

        btn.MouseButton1Click:Connect(switch)
        if name == "ESP" then switch() end
    end
end


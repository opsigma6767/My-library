local function addSliderRow(tabName, labelText, min, max, step, stateTable, key, callback)
    local row, accent = createRowBase(tabName, labelText)
    row.Size = UDim2.new(1, -24, 0, 52)

    local slideTrack = Instance.new("TextButton")
    slideTrack.Size = UDim2.new(0, 160, 0, 6)
    slideTrack.Position = UDim2.new(1, -225, 0.5, -3)
    slideTrack.BackgroundColor3 = Color3.fromRGB(225, 225, 230)
    slideTrack.Text = ""
    slideTrack.AutoButtonColor = false
    slideTrack.Parent = row

    local sc = Instance.new("UICorner")
    sc.CornerRadius = UDim.new(0, 3)
    sc.Parent = slideTrack

    local slideFill = Instance.new("Frame")
    slideFill.Size = UDim2.new(0, 0, 1, 0)
    slideFill.BackgroundColor3 = Color3.fromRGB(40, 120, 255)
    slideFill.BorderSizePixel = 0
    slideFill.Parent = slideTrack

    local sfc = Instance.new("UICorner")
    sfc.CornerRadius = UDim.new(0, 3)
    sfc.Parent = slideFill

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new(0, -7, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Parent = slideFill

    local kc = Instance.new("UICorner")
    kc.CornerRadius = UDim.new(0, 7)
    kc.Parent = knob

    local ks = Instance.new("UIStroke")
    ks.Color = Color3.fromRGB(40, 120, 255)
    ks.Thickness = 1.5
    ks.Parent = knob

    local valInput = Instance.new("TextBox")
    valInput.Size = UDim2.new(0, 45, 0, 24)
    valInput.Position = UDim2.new(1, -55, 0.5, -12)
    valInput.BackgroundColor3 = Color3.fromRGB(240, 240, 245)
    valInput.Text = tostring(stateTable[key])
    valInput.Font = Enum.Font.Code
    valInput.TextSize = 12
    valInput.TextColor3 = Color3.fromRGB(60, 60, 65)
    valInput.ClearTextOnFocus = false
    valInput.Parent = row

    local vc = Instance.new("UICorner")
    vc.CornerRadius = UDim.new(0, 4)
    vc.Parent = valInput

    local function setPct(pct)
        pct = math.clamp(pct, 0, 1)
        local rawVal = min + (max - min) * pct
        local finalVal = math.round(rawVal / step) * step
        finalVal = math.clamp(finalVal, min, max)
        stateTable[key] = finalVal
        valInput.Text = tostring(finalVal)
        slideFill.Size = UDim2.new((finalVal - min) / (max - min), 0, 1, 0)
        applyTween(accent, {0.1}, {BackgroundColor3 = Color3.fromRGB(40, 120, 255)})
        if callback then callback(finalVal) end
    end

    local function updateUI(currentVal)
        local pct = (currentVal - min) / (max - min)
        slideFill.Size = UDim2.new(pct, 0, 1, 0)
        valInput.Text = tostring(currentVal)
    end

    local activeSliding = false
    slideTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeSliding = true
            local offset = input.Position.X - slideTrack.AbsolutePosition.X
            setPct(offset / slideTrack.AbsoluteSize.X)
        end
    end)

    connections[#connections+1] = UserInputService.InputChanged:Connect(function(input)
        if activeSliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local offset = input.Position.X - slideTrack.AbsolutePosition.X
            setPct(offset / slideTrack.AbsoluteSize.X)
        end
    end)

    connections[#connections+1] = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then activeSliding = false end
    end)

    valInput.FocusLost:Connect(function()
        local n = tonumber(valInput.Text)
        if n then setPct((n - min) / (max - min)) else updateUI(stateTable[key]) end
    end)

    updateUI(stateTable[key])
    registerRowSync(stateTable, key, updateUI)
end

